# Copy to .env and fill in. Never commit real values.

# Public (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Marketing site; signed-out visitors of "/" are redirected there (optional)
NEXT_PUBLIC_SITE_URL=

# Server only
SUPABASE_SERVICE_ROLE_KEY=
# Supabase pooler, transaction mode (port 6543), for runtime SQL:
# postgresql://postgres.<ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true
DATABASE_URL=
# Supabase pooler, session mode (port 5432), for migrations and seeding:
# postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres
DIRECT_URL=
# Optional: path to the Supabase CA certificate for verified TLS
DATABASE_CA_CERT=

# OpenAI — the only AI provider (text agent, voice agent, transcription, images)
OPENAI_API_KEY=
# Optional model overrides
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_REALTIME_MODEL=gpt-realtime

# At least 32 characters, e.g. `openssl rand -base64 32` (encrypts integration tokens)
ENCRYPTION_KEY=

# DocuSign eSignature — optional; without these, signing shows "non configurée".
# Integration key (app) + API user GUID + API account ID, from Apps and Keys.
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
# RSA private key of the integration key (PEM, newlines as 
 on one line)
DOCUSIGN_PRIVATE_KEY=
# Demo sandbox by default; production: https://<region>.docusign.net/restapi
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
# Connect HMAC key (Settings → Connect → Connect keys) to verify webhooks
DOCUSIGN_WEBHOOK_SECRET=

# Web push (PWA reminders). Generate a pair: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@pratonna.com
# Long random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Gmail / Outlook (optional). Redirect URIs to register:
#   <NEXT_PUBLIC_APP_URL>/api/integrations/google/callback
#   <NEXT_PUBLIC_APP_URL>/api/integrations/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "common" (default) for work and personal accounts, or your tenant id
MS_TENANT_ID=

# Accounting connectors — interface only for now (Phase 6). The FEC and CSV
# exports in /app/reports work without them.
PENNYLANE_API_KEY=
QONTO_ORGANIZATION_SLUG=
QONTO_SECRET_KEY=
